{
    "build": {
        "appId": "app.rdz.desktop",
        "compression": "maximum",
        "directories": {
            "output": "dist"
        },
        "electronLanguages": [
            "pt-BR",
            "en-US"
        ],
        "files": [
            "main.js",
            "preload.js",
            "package.json"
        ],
        "productName": "rdz",
        "win": {
            "artifactName": "rdz.exe",
            "extraResources": [
                {
                    "from": "loopback/publish/rdz-loopback.exe",
                    "to": "rdz-loopback.exe"
                }
            ],
            "target": [
                {
                    "arch": [
                        "x64"
                    ],
                    "target": "portable"
                }
            ]
        }
    },
    "description": "transmissor desktop do rdz",
    "devDependencies": {
        "electron": "^35.7.5",
        "electron-builder": "^26.0.12"
    },
    "main": "main.js",
    "name": "rdz-desktop",
    "private": true,
    "productName": "rdz",
    "scripts": {
        "build": "npm run loopback && electron-builder --win portable --x64",
        "loopback": "dotnet publish loopback/RdzLoopback.csproj -c Release -o loopback/publish",
        "start": "electron ."
    },
    "version": "1.0.0"
}
